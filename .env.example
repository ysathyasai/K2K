# Environment Variables for Project Khet2Kitchen (K2K)
DJANGO_SECRET_KEY=your-production-secret-key-here-32chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database Connection (MySQL on Render, TiDB, AWS RDS, or local MySQL)
DATABASE_URL=mysql://k2k_user:k2k_password@localhost:3306/k2k_db

# Or individual MySQL variables
MYSQL_DATABASE=k2k_db
MYSQL_USER=k2k_user
MYSQL_PASSWORD=k2k_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Platform configurations
K2K_AI_GRADING_CONFIDENCE_THRESHOLD=0.820
K2K_MAX_LOAN_DEDUCTION_RATIO=0.50
